{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.3"}
        io.github.kotoba-lang/json {:git/sha "b47b06486b3ad53051bc7d8bf361f4176f467202"}}
 :aliases
 {;; Working operator start is compile + instantiateKotoba:
  ;;   sh scripts/kotoba-compile.sh
  ;;   sh scripts/kotoba-run.sh
  ;; Intended public command (CLI source-run gap until the CLI accepts this guest):
  ;;   kotoba run kotoba/launcher.kotoba
  ;; There is no kotoba -M. :run is gone (not leftover-jvm-run-path exit 2).
  ;; Leftover Java in src/kotoba/shell/launcher.clj stays as a library —
  ;; not a start path. Default CI is kotoba compile + instantiateKotoba.
  :test {:extra-paths ["test" "apps/tamaki-observer/src"]
         :extra-deps {tamaki/tamaki {:local/root "../../etzhayyim/tamaki"}}
         :main-opts ["-m" "kotoba.shell.launcher-test"]}
  ;; leftover JVM lint (workflow_dispatch leftover-jvm.yml only).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
