#!/usr/bin/env bash
set -euo pipefail

# Operator start is kotoba run / kotoba compile. There is no kotoba -M
# and no clojure -M / clj -M start path.
#
# Replaces the former:
#   exec clojure -Sdeps ... -M -m kotoba.shell.launcher
# That wrapper is gone, not leftover-jvm-run-path exit 2.
repo_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"

if ! command -v kotoba >/dev/null 2>&1; then
  echo "kotoba CLI is not on PATH. Operator start is:" >&2
  echo "  kotoba run kotoba/launcher.kotoba" >&2
  echo "  kotoba compile kotoba/launcher.kotoba --target wasm --output target/kotoba/launcher.wasm --json" >&2
  echo "  kotoba compile kotoba/launcher.kotoba --target web --output target/kotoba/launcher.mjs --json" >&2
  echo "There is no kotoba -M and no clojure -M start." >&2
  exit 127
fi

exec kotoba run kotoba/launcher.kotoba "$@"
