#!/usr/bin/env bash
set -euo pipefail

# With NO arguments the working operator start is compile + instantiateKotoba.
# There is no kotoba -M and no kbb -M / kbb -M start path.
#
# Replaces the former:
#   exec kbb -Sdeps ... -M -m kotoba.shell.launcher
# That wrapper is gone, not leftover-jvm-run-path exit 2.
#
# Do not exec `kotoba run kotoba/launcher.kotoba` here. On Release CLI,
# source-run of this guest is kotoba/runtime-rejected (typed forms). That
# is the intended public command and a named CLI gap, not a working start.
repo_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# Subcommands (`app scaffold|check|build|package|run ...`, `release ...`,
# `store ...`) run the launcher library on the kbb engine (SCI on Node, no
# JVM) through bin/kotoba_shell.cljk.
#
# The working directory is NOT changed: --manifest, :web/dist-dir and
# --output-dir resolve against the caller's directory (the consumer repo).
# Until 2026-09-23 this wrapper cd'd into kotoba-lang/shell first and then
# refused every subcommand with exit 2, because the launcher was JVM code
# that the kbb engine could not load — there was no working way to build an
# iOS app with kotoba-shell. Host effects now go through kotoba.shell.host.
#
# kbb is resolved from PATH, or $KBB when set.
if [ "$#" -gt 0 ]; then
  kbb_bin="${KBB:-kbb}"
  if ! command -v "$kbb_bin" >/dev/null 2>&1; then
    echo "kotoba-shell: kbb not found (set KBB or put kotoba-lang/kotoba/bin on PATH); cannot run: $*" >&2
    exit 2
  fi
  exec "$kbb_bin" --backend sci \
    --config "$repo_dir/nbb.edn" \
    --classpath "$repo_dir/src:$repo_dir/resources" \
    "$repo_dir/bin/kotoba_shell.cljk" "$@"
fi

# No arguments: the Kotoba operator demo (compile + instantiateKotoba).
cd "$repo_dir"
sh scripts/kotoba-compile.sh
exec sh scripts/kotoba-run.sh
