#!/usr/bin/env bash
set -euo pipefail

shell_dir="$(cd "$(dirname "$0")/.." && pwd)"
app_dir="$shell_dir/apps/tamaki-observer"
tamaki_dir="${TAMAKI_PROJECT_DIR:-$(cd "$shell_dir/../tamaki" && pwd)}"
workspace_root="${KOTOBA_WORKSPACE_ROOT:-$(cd "$shell_dir/../../.." && pwd)}"

export TAMAKI_STATE_DIR="${TAMAKI_STATE_DIR:-$tamaki_dir/.tamaki}"
export KOTOBA_WORKSPACE_ROOT="$workspace_root"
export KOTOBA_WEST_MANIFEST="${KOTOBA_WEST_MANIFEST:-$workspace_root/manifest/west.yml}"
export KOTOBA_REPO_INDEX="${KOTOBA_REPO_INDEX:-$TAMAKI_STATE_DIR/workspace-repos.txt}"
repo_index_next="$KOTOBA_REPO_INDEX.next.$$"
(
  find "$workspace_root/orgs" "$workspace_root/projects" "$workspace_root/packages" \
    -type d \( -name node_modules -o -name target -o -name .cache \) -prune -o \
    -type d -name .git -print -prune 2>/dev/null |
    sed "s#^$workspace_root/##; s#/.git\$##" |
    sort -u > "$repo_index_next"
  mv "$repo_index_next" "$KOTOBA_REPO_INDEX"
) &
export KOTOBA_SHELL_APP_DIR="$app_dir"
export KOTOBA_SHELL_MANIFEST="$app_dir/app.kotoba.edn"
export KOTOBA_SHELL_TITLE="Tamaki Observatory"
export KOTOBA_SHELL_WIDTH="${KOTOBA_SHELL_WIDTH:-980}"
export KOTOBA_SHELL_HEIGHT="${KOTOBA_SHELL_HEIGHT:-820}"
export KOTOBA_SHELL_MIN_WIDTH="${KOTOBA_SHELL_MIN_WIDTH:-640}"
export KOTOBA_SHELL_MIN_HEIGHT="${KOTOBA_SHELL_MIN_HEIGHT:-560}"
export KOTOBA_SHELL_WATCH=1
export KOTOBA_SHELL_FLOATING=1
export KOTOBA_SHELL_REFRESH_SECONDS="${KOTOBA_SHELL_REFRESH_SECONDS:-1}"
export KOTOBA_SHELL_EXTRA_WATCH_ROOTS="$TAMAKI_STATE_DIR"
export TAMAKI_VISUAL_SNAPSHOT_PATH="${TAMAKI_VISUAL_SNAPSHOT_PATH:-$TAMAKI_STATE_DIR/visual/live.png}"

web_dir="$shell_dir/apps/tamaki-observer-web"
web_dist="$web_dir/dist"
web_host="$shell_dir/target/kotoba-shell-host-macos-webview"
data_pid=""

cleanup() {
  if [[ -n "$data_pid" ]] && kill -0 "$data_pid" 2>/dev/null; then
    kill "$data_pid" 2>/dev/null || true
    wait "$data_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

if [[ ! -d "$web_dir/node_modules" ]]; then
  npm --prefix "$web_dir" install
fi
npm --prefix "$web_dir" run build
"$shell_dir/bin/kotoba-shell-build-macos-webview" "$web_host" >/dev/null

mkdir -p "$web_dir/target"
(
  cd "$app_dir"
  exec clojure -M -m kotoba.shell.tamaki-web-data "$web_dist/snapshot.json"
) >>"$web_dir/target/data.log" 2>&1 &
data_pid=$!

for _ in {1..50}; do
  [[ -f "$web_dist/snapshot.json" ]] && break
  sleep 0.1
done

"$web_host" "$web_dist"
